# Скопируй в .env и заполни (см. README.md, Шаги 1-4)

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=

# Twitch (необязательно: без них бот только постит, уведомлений о стриме нет)
# Чтобы включить — заполни и на Vercel тоже, потом `npm run subscribe`
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_USER_ID=
EVENTSUB_SECRET=

# Vercel
PUBLIC_BASE_URL=https://<project>.vercel.app

# Redis / Upstash (необязательно: без него черновик неопубликованного поста живёт
# только в памяти функции и теряется при передеплое).
# Ставится интеграцией: `vc i redis` или Storage → Redis в дашборде Vercel.
# Поддержаны обе пары — заполни ту, которую дала интеграция.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=